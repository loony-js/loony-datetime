{
  "name": "loony-datetime",
  "version": "0.1.0",
  "description": "A simple datetime utility library for Loony framework.",
  "type": "module",
  "private": false,
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "loony-datetime",
    "datetime"
  ],
  "author": "Sankar Boro",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/loony-js/loony-datetime.git"
  },
  "scripts": {
    "clean": "rm -rf lib dist",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
